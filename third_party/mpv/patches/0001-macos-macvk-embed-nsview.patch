+    // Embedded mode reuses MPV's MetalLayer and Vulkan surface while Aurora
+    // owns the top-level window. MPV's input view becomes a child of Aurora's NSView.
+    private func initEmbeddedView(_ metalLayer: MetalLayer, host: NSView) {
+        let embedded = View(frame: host.bounds, common: self)
+        embedded.autoresizingMask = [.width, .height]
+        embedded.layer = metalLayer
+        embedded.wantsLayer = true
+        embedded.layerContentsPlacement = .scaleProportionallyToFit
+        metalLayer.delegate = embedded
+        host.addSubview(embedded)
+        view = embedded
+    }
+
+    private func observeEmbeddedHost() {
+        guard let host = embeddedHostView else { return }
+        let center = NotificationCenter.default
+
+        if hostViewObservers.isEmpty {
+            host.postsBoundsChangedNotifications = true
+            host.postsFrameChangedNotifications = true
+            for name in [NSView.boundsDidChangeNotification, NSView.frameDidChangeNotification] {
+                hostViewObservers.append(center.addObserver(
+                    forName: name, object: host, queue: .main
+                ) { [weak self] _ in
+                    self?.updateEmbeddedViewMetrics()
+                })
+            }
+        }
+
+        guard let hostWindow = host.window, observedHostWindow !== hostWindow else { return }
+        hostWindowObservers.forEach { center.removeObserver($0) }
+        hostWindowObservers.removeAll()
+        observedHostWindow = hostWindow
+        for name in [
+            NSWindow.didChangeScreenNotification,
+            NSWindow.didChangeBackingPropertiesNotification,
+            NSWindow.didChangeOcclusionStateNotification,
+            NSWindow.didBecomeKeyNotification,
+            NSWindow.didResignKeyNotification
+        ] {
+            hostWindowObservers.append(center.addObserver(
+                forName: name, object: hostWindow, queue: .main
+            ) { [weak self] _ in
+                self?.updateEmbeddedViewMetrics()
+                self?.updateICCProfile()
+                self?.updateDisplaylink()
+            })
+        }
+    }
