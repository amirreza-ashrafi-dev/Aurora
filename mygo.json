{
  "name": "Aurora Player",
  "identifier": "com.aurora.player",
  "version": "0.1.0",
  "out": "build",
  "resources": [
    "third_party/mpv/libmpv-2.dll",
    "third_party/mpv/d3dcompiler_43.dll",
    "third_party/ffmpeg/ffmpeg.exe"
  ],
  "icon": "resources/icon.png",
  "fileAssociations": [
    {
      "ext": [
        "mp4",
        "mkv",
        "avi",
        "mov",
        "wmv",
        "webm",
        "m4v",
        "mpg",
        "mpeg",
        "ts",
        "m2ts",
        "flv",
        "ogv",
        "3gp"
      ],
      "name": "Video File",
      "role": "Viewer"
    }
  ]
}
