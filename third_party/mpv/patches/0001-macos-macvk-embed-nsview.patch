+    }
+
+    @objc func embeddedViewDidResize() {
+        guard embeddedHostView != nil else { return }
+        updateEmbeddedViewMetrics()
+    }
+
+    private func updateEmbeddedViewMetrics() {
+        guard let host = embeddedHostView, let view = view else { return }
+        if view.superview !== host {
+            host.addSubview(view)
+        }
+        if view.frame != host.bounds {
+            view.frame = host.bounds
+        }
